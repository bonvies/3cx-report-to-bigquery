# 選擇要跑哪個 report — 支援的值請看 src/index.ts 裡的 switch
REPORT_TYPE=callLog

# 業務時區設定 預設 Asia/Taipei
SITE_TIMEZONE=Asia/Taipei

BASE_URL_3CX=https://yourpbx.3cx.tw
CLIENT_ID_3CX=
CLIENT_SECRET_3CX=

BQ_PROJECT_ID=
BQ_DATASET=

# BigQuery 認證用的服務帳戶金鑰路徑（選填）。
# 留空的話會走 ADC 後援機制（本機用 `gcloud auth application-default login` 登入的個人帳號，
# 部署到 GCP 服務上則用該服務綁定的身分），不用改任何程式碼，@google-cloud/bigquery 會自動讀這個環境變數。
GOOGLE_APPLICATION_CREDENTIALS=

# 同步區間，比照 3CX 網頁報表的快速選項，**必填、沒有預設值**
# 選項：custom | thisMinute | thisHour | today | yesterday | last7Days | lastWeek | last30Days
#      | thisMonth | lastMonth | thisYear | lastYear
PERIOD_PRESET=yesterday

# 自訂 backfill 區間（ISO 8601）— 只有 PERIOD_PRESET=custom 時才會用到
PERIOD_FROM=
PERIOD_TO=
