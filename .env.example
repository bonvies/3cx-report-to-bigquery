# 選擇要跑哪個 report — 支援的值請看 src/index.ts 裡的 switch
REPORT_TYPE=callLog

BASE_URL_3CX=https://yourpbx.3cx.tw
CLIENT_ID_3CX=
CLIENT_SECRET_3CX=

BQ_PROJECT_ID=
BQ_DATASET=

# 相對同步區間：抓「現在往前推 N 個單位」的資料
# 單位選項：minute | hour | day | week | month | year
SYNC_LOOKBACK_UNIT=day
SYNC_LOOKBACK_AMOUNT=1

# 自訂 backfill 區間 — 兩個都有設定時，會直接覆蓋 SYNC_LOOKBACK_UNIT/SYNC_LOOKBACK_AMOUNT
SYNC_SINCE_3CX=
SYNC_UNTIL_3CX=
